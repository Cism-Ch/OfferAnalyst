// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  name          String?
  password      String?
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  profile        Profile?
  apiKeys        APIKey[]
  searchHistory  SearchHistory[]
  savedOffers    SavedOffer[]
  projects       Project[]
  accounts       Account[]
  sessions       Session[]
  subscriptions  Subscription[]
  credits        Credit[]
  apiKeyUsageLogs APIKeyUsageLog[]
  securityAlerts SecurityAlert[]
  analysisResults AnalysisResult[]
  sharedAnalyses SharedAnalysis[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]

  @@index([createdAt])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  EDITOR
  VIEWER
}

// OAuth accounts
model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                String    @db.ObjectId
  accountId             String?
  providerId            String?
  accessToken           String?   @db.String
  refreshToken          String?   @db.String
  idToken               String?   @db.String
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime? @default(now())
  updatedAt             DateTime? @updatedAt

  // Legacy NextAuth fields
  type                  String?
  provider              String?
  providerAccountId     String?
  refresh_token         String?   @db.String
  access_token          String?   @db.String
  expires_at            Int?
  token_type            String?
  session_state         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Session management
model Session {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  token        String?   @unique
  expiresAt    DateTime?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt

  // Legacy NextAuth fields
  sessionToken String?   @unique
  expires      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Better-Auth verification model
model Verification {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Email verification tokens (legacy)
model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// User profile extended information
model Profile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  bio             String?
  company         String?
  location        String?
  website         String?
  avatar          String?
  theme           String   @default("light")
  language        String   @default("en")
  notifications   Boolean  @default(true)
  useCase         String?  // Real Estate, Jobs, Startups, etc.
  onboardingStep  Int      @default(0)
  onboardingComplete Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// API Keys for BYOK (Bring Your Own Key)
model APIKey {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  name         String
  provider     String    // openrouter, google, anthropic, etc.
  keyEncrypted String    // Encrypted key for security (AES-256-GCM)
  keyPreview   String    // Last 4 chars for display
  permissions  String[]  @default(["READ", "WRITE"])
  priority     Int       @default(0) // Higher priority = used first (0 = lowest)
  lastUsed     DateTime?
  usageCount   Int       @default(0)
  rateLimit    Int?      // Optional: max requests per hour (null = unlimited)
  isActive         Boolean   @default(true)
  isPrimary        Boolean   @default(false) // Mark as primary/default key for provider
  expiresAt        DateTime? // Optional: expiration date for the key
  healthStatus     String    @default("UNKNOWN") // OPERATIONAL, DEGRADED, ERROR, RATE_LIMITED, UNKNOWN
  lastChecked      DateTime?
  lastPingLatency  Int?      // Response time in ms during health check
  lastError        String?
  creditsRemaining Float?    // Real-time balance from provider API in USD ($)
  creditsLimit     Float?    // Configured hard/soft limit in USD ($)
  totalTokensUsed  Int       @default(0)
  totalCostUsd     Float     @default(0.0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([expiresAt])
  @@index([priority])
  @@map("api_keys")
}

// Subscription model (for future use)
model Subscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  plan      String   @default("FREE")
  status    String   @default("ACTIVE")
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// Search history from localStorage migration
model SearchHistory {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  domain           String
  criteria         String   @db.String
  implicitContext  String?  @db.String
  model            String
  timestamp        DateTime @default(now())
  resultCount      Int      @default(0)
  isPinned         Boolean  @default(false)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@index([isPinned])
  @@map("search_history")
}

// Saved offers from localStorage migration
model SavedOffer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  offerId     String   // Original offer ID
  title       String
  description String   @db.String
  url         String?
  score       Float
  category    String?
  data        String   @db.String // JSON stringified offer data
  savedAt     DateTime @default(now())
  tags        String[] @default([])
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([savedAt])
  @@index([score])
  @@map("saved_offers")
}

// Project workspaces for multi-source research
model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  name        String
  description String?  @db.String
  sources     String[] @default([])
  data        String   @db.String // JSON stringified project data
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("projects")
}

// Credits tracking (for API usage monitoring)
model Credit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  action    String   // FETCH, ANALYZE, ORGANIZE
  model     String?
  amount    Int      @default(1)
  metadata  String?  @db.String // JSON for additional info
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("credits")
}

// Analytics events for privacy-first tracking
model AnalyticsEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String   // Event type: page_view, search_started, etc.
  userId    String?  @db.ObjectId
  metadata  String?  @db.String // JSON stringified metadata
  userAgent String?
  path      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("analytics_events")
}

// Performance metrics for Web Vitals tracking
model PerformanceMetric {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   // Metric name: FCP, LCP, CLS, TTFB, FID, INP
  value     Float    // Metric value
  rating    String   // Rating: good, needs-improvement, poor
  path      String?
  userId    String?  @db.ObjectId
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([name])
  @@index([createdAt])
  @@index([rating])
  @@map("performance_metrics")
}


// API Key Usage Logs for detailed analytics
model APIKeyUsageLog {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String?  @db.ObjectId
  apiKeyId         String?  // Optional: BYOK key ObjectId or null for system key
  provider         String   // openrouter, openai, etc.
  action           String   // fetch, analyze, organize
  model            String?  // AI model used
  tokensUsed       Int?     // Total tokens consumed
  promptTokens     Int?     // Input prompt tokens
  completionTokens Int?     // Output completion tokens
  costUsd          Float?   // Estimated cost in USD ($)
  statusCode       Int?     // HTTP Status Code (200, 429, 401, 503)
  success          Boolean  @default(true)
  errorMessage     String?  @db.String
  responseTime     Int?     // Response time in ms
  ipAddress        String?
  userAgent        String?  @db.String
  timestamp        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([apiKeyId])
  @@index([timestamp])
  @@index([provider])
  @@map("api_key_usage_logs")
}

// Security Alerts for suspicious activity
model SecurityAlert {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  apiKeyId    String?  @db.ObjectId
  alertType   String   // rate_limit_exceeded, unusual_activity, expired_key_usage, etc.
  severity    String   // low, medium, high, critical
  message     String   @db.String
  metadata    String?  @db.String // JSON stringified additional data
  isRead      Boolean  @default(false)
  isResolved  Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([apiKeyId])
  @@index([alertType])
  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
  @@map("security_alerts")
}

// Analysis Results for storing AI-generated offer rankings & insights
model AnalysisResult {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  domain          String
  criteria        String?  @db.String
  model           String
  language        String   @default("en")
  marketSummary   String   @db.String
  topOffers       String   @db.String // JSON stringified scored offers
  criteriaWeights String?  @db.String // JSON stringified criteria weights
  totalAnalyzed   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([domain])
  @@index([createdAt])
  @@map("analysis_results")
}

// Shared analyses for read-only collaboration & public sharing
model SharedAnalysis {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  shareToken      String    @unique
  title           String?
  domain          String
  criteria        String?   @db.String
  model           String?
  marketSummary   String    @db.String
  topOffers       String    @db.String // JSON stringified ScoredOffer[]
  searchSources   String?   @db.String // JSON stringified SearchSource[]
  totalAnalyzed   Int       @default(0)
  views           Int       @default(0)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  userId          String?   @db.ObjectId

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("shared_analyses")
}

// Workspaces & Multi-tenancy
model Workspace {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?  @db.String
  ownerId     String   @db.ObjectId
  plan        String   @default("free") // "free", "pro", "enterprise"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String        @db.ObjectId
  userId      String?       @db.ObjectId
  email       String
  name        String?
  role        WorkspaceRole @default(MEMBER)
  status      String        @default("active") // "active", "invited"
  joinedAt    DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([userId])
  @@index([email])
  @@map("workspace_members")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}
