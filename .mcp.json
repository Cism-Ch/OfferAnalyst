{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ]
    },
    "motion": {
      "type": "http",
      "url": "https://mcp.motion.dev"
    },
    "motion-plus": {
      "type": "http",
      "url": "https://mcp.motion.dev/plus"
    },
    "upstash": {
      "type": "http",
      "url": "https://mcp.upstash.com/mcp"
    },
    "tigris": {
      "command": "npx",
      "args": [
        "-y",
        "@tigrisdata/tigris-mcp-server",
        "run"
      ]
    }
  }
}
